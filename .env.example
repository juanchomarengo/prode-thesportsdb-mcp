# Copy to .env (local) or set these as environment variables on your host.

# REQUIRED — your TheSportsDB PREMIUM key (enables the V2 API). Find it on your
# TheSportsDB user profile after upgrading. NEVER put this in the Prode page.
THESPORTSDB_KEY=your_premium_key_here

# OPTIONAL — lock down your MCP endpoint. If set, callers must send
#   Authorization: Bearer <this value>
# Put this SAME value in the Prode "Token (opcional)" field so only your agent can use it.
MCP_AUTH_TOKEN=

# OPTIONAL — defaults are fine for the 2026 World Cup.
WC_LEAGUE_ID=4429
WC_SEASON=2026
PORT=8080
